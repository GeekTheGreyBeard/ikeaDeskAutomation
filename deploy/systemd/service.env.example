# Copy to ~/.config/ikea-desk/service.env and edit for the local host.
#
# Keep dry-run mode until the current physical setup has been validated after
# boot, login, camera reconnect, Bluetooth reconnect, and visitor traffic tests.

# Path to the installed console script. For an editable checkout, point this at
# the venv wrapper, for example:
# IKEA_DESK_BIN=/path/to/ikeaDeskAutomation/.venv/bin/ikea-desk
IKEA_DESK_BIN=/usr/local/bin/ikea-desk

# Runtime config. Leave unset to use the service default:
# ~/.config/ikea-desk/config.yaml
# IKEA_DESK_CONFIG=/home/your-user/.config/ikea-desk/config.yaml

# Default is dry-run. Physical movement requires adding --execute intentionally.
IKEA_DESK_MONITOR_ARGS=monitor

# After supervised production-readiness validation, this is the live form:
# IKEA_DESK_MONITOR_ARGS=monitor --execute
